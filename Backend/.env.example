# SMS Service Configuration
# Choose ONE of the following SMS providers and configure accordingly

# ===== OPTION 1: Twilio (Recommended) =====
# Get credentials from: https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ===== OPTION 2: AWS SNS =====
# Get credentials from: https://aws.amazon.com/sns/
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# ===== OPTION 3: Generic HTTP SMS API =====
# Works with Fast2SMS, Vonage, Bandwidth, etc.
# SMS_API_URL=https://api.yoursmsservice.com/send
# SMS_API_KEY=your_api_key

# If NONE of the above are configured, SMS will run in DEMO MODE
# (OTPs will be logged to console but not actually sent)

# App Configuration
PORT=5000
NODE_ENV=production
